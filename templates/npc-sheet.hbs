<div class="srd35-ledger srd35-npc {{#if _adjusting}}is-adjusting{{/if}}">

  {{!-- Top: small portrait + name + size/type line + adjust --}}
  <header class="srd35-npc-top">
    <button type="button" class="srd35-portrait srd35-npc-portrait" data-action="pick-portrait" title="{{localize "sheet.portrait"}}">
      {{#if _avatar}}<img src="{{_avatar}}" alt="" />{{else}}<i class="fa-solid fa-user"></i>{{/if}}
      <span class="srd35-portrait-edit"><i class="fa-solid fa-pen"></i></span>
    </button>
    <div class="srd35-npc-id">
      <input class="srd35-in srd35-name" type="text" name="name" value="{{name}}" placeholder="{{localize "sheet.name"}}" />
      <div class="srd35-head-line">
        <select class="srd35-in srd35-select" name="sd:size" title="{{localize "sheet.size"}}">
          {{#each _sizeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize (concat "sizes." value)}}</option>{{/each}}
        </select>
        {{#if _kind}}<span class="srd35-race">{{_kind}}</span>{{/if}}
        <span class="srd35-npc-level">{{localize "sheet.level"}} <b>{{_level}}</b></span>
      </div>
    </div>
    <button type="button" class="srd35-adjust-toggle" data-action="toggle-adjust" title="{{localize "sheet.adjustHint"}}">
      <i class="fa-solid fa-sliders"></i><span>{{localize "sheet.adjust"}}</span>
    </button>
  </header>

  {{!-- Vitals: HP + Defense side by side --}}
  <div class="srd35-npc-vitals">
    <section class="srd35-card srd35-hp">
      <h3 class="srd35-card-title">{{localize "sheet.hp"}}</h3>
      <div class="srd35-hp-figure">
        <input class="srd35-in srd35-big" type="number" name="sd:hp.value" value="{{_hp.value}}" title="{{localize "sheet.current"}}" />
        <span class="srd35-hp-sep">/</span>
        <span class="srd35-big srd35-derived" title="{{localize "sheet.maxTotalHint"}}">{{_hp.maxTotal}}</span>
      </div>
      <div class="srd35-bar"><span style="width: {{_hp.pct}}%"></span></div>
      <div class="srd35-hp-foot">
        <label>{{localize "sheet.temp"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:hp.temp" value="{{_hp.temp}}" /></label>
      </div>
      <div class="srd35-adj srd35-adj-grid">
        <label>{{localize "sheet.rolledHp"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:hp.max" value="{{_hp.max}}" /></label>
        <label>{{localize "sheet.bonus"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:hp.bonus" value="{{_hp.bonus}}" /></label>
      </div>
    </section>

    <section class="srd35-card srd35-defense">
      <h3 class="srd35-card-title">{{localize "sheet.defense"}}</h3>
      <div class="srd35-ac-trio">
        <div class="srd35-ac srd35-ac-main" tabindex="0">
          <span class="srd35-ac-shield"><strong>{{_ac}}</strong></span>
          <span>{{localize "sheet.ac"}}</span>
          <div class="srd35-sum" role="tooltip">
            {{#each _acParts}}<div class="srd35-sum-line"><b>{{value}}</b><i>{{localize (concat "sheet." key)}}</i></div>{{/each}}
            <div class="srd35-sum-line srd35-sum-total"><b>{{_ac}}</b><i>{{localize "sheet.ac"}}</i></div>
          </div>
        </div>
        <div class="srd35-ac" title="{{_touchTitle}}"><strong>{{_touch}}</strong><span>{{localize "sheet.touch"}}</span></div>
        <div class="srd35-ac" title="{{_ffTitle}}"><strong>{{_flatFooted}}</strong><span>{{localize "sheet.flatFooted"}}</span></div>
      </div>
      <div class="srd35-adj srd35-adj-grid">
        <label>{{localize "sheet.armor"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.armor" value="{{systemData.ac.armor}}" /></label>
        <label>{{localize "sheet.shield"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.shield" value="{{systemData.ac.shield}}" /></label>
        <label>{{localize "sheet.natural"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.natural" value="{{systemData.ac.natural}}" /></label>
        <label>{{localize "sheet.deflection"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.deflection" value="{{systemData.ac.deflection}}" /></label>
        <label>{{localize "sheet.dodge"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.dodge" value="{{systemData.ac.dodge}}" /></label>
        <label>{{localize "sheet.misc"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.misc" value="{{systemData.ac.misc}}" /></label>
        <label>{{localize "sheet.maxDex"}} <input class="srd35-in srd35-in-sm" type="text" name="sd:ac.maxDex" value="{{systemData.ac.maxDex}}" placeholder="—" /></label>
        <label>{{localize "sheet.checkPenalty"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:ac.checkPenalty" value="{{systemData.ac.checkPenalty}}" /></label>
      </div>
    </section>
  </div>

  {{!-- Saves + initiative + offense --}}
  <section class="srd35-card srd35-npc-mid">
    <div class="srd35-save-trio">
      {{#each _saves}}
      <div class="srd35-save">
        <button type="button" class="srd35-roll srd35-save-total" data-action="roll-save" data-key="{{key}}" title="{{title}}">{{totalFmt}}</button>
        <span class="srd35-save-name">{{localize (concat "saves." key)}}</span>
        <label class="srd35-adj">{{localize "sheet.base"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:saves.{{key}}.base" value="{{base}}" /></label>
      </div>
      {{/each}}
    </div>
    <div class="srd35-npc-mid-foot">
      <button type="button" class="srd35-roll srd35-npc-init" data-action="roll-initiative">
        <span>{{localize "sheet.initiative"}}</span><strong>{{_initiative}}</strong>
      </button>
      <span class="srd35-npc-offense" title="{{localize "sheet.babHint"}}">
        {{localize "sheet.bab"}} <b>{{_babLabel}}</b>
      </span>
      <button type="button" class="srd35-roll srd35-npc-offense" data-action="roll-grapple">
        {{localize "sheet.grapple"}} <b>{{_grapple}}</b>
      </button>
    </div>
    <div class="srd35-adj srd35-adj-grid">
      <label>{{localize "sheet.initMisc"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:initiative.misc" value="{{systemData.initiative.misc}}" /></label>
      <label>{{localize "sheet.bab"}} {{localize "sheet.misc"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:combat.babMisc" value="{{systemData.combat.babMisc}}" /></label>
      <label>{{localize "sheet.grapple"}} {{localize "sheet.misc"}} <input class="srd35-in srd35-in-sm" type="number" name="sd:combat.grappleMisc" value="{{systemData.combat.grappleMisc}}" /></label>
    </div>
  </section>

  {{!-- Attacks --}}
  <section class="srd35-card srd35-offense">
    <h3 class="srd35-card-title">{{localize "sheet.attacks"}}</h3>
    {{#if _weapons.length}}
    <ul class="srd35-weapons">
      {{#each _weapons}}
      <li class="srd35-weapon" data-id="{{id}}">
        <button type="button" class="srd35-weapon-name" data-action="open-item" data-id="{{id}}">{{name}}</button>
        <span class="srd35-weapon-atks">
          {{#each attacks}}<button type="button" class="srd35-roll srd35-atk" data-action="roll-attack" data-id="{{../id}}" data-attack-index="{{index}}" title="{{localize "sheet.attack"}}">{{bonusFmt}}</button>{{/each}}
        </span>
        <button type="button" class="srd35-roll srd35-damage" data-action="roll-damage" data-id="{{id}}" title="{{localize "sheet.damage"}}">{{damage}}</button>
        <span class="srd35-crit" title="{{localize "sheet.crit"}}">{{critLabel}}</span>
        <span class="srd35-weapon-tools">
          <button type="button" data-action="roll-confirm" data-id="{{id}}" title="{{localize "sheet.confirm"}}"><i class="fa-solid fa-crosshairs"></i></button>
          <button type="button" data-action="roll-damage-crit" data-id="{{id}}" title="{{localize "sheet.critDamage"}}"><i class="fa-solid fa-burst"></i></button>
          <button type="button" data-action="delete-item" data-id="{{id}}" title="{{localize "sheet.delete"}}"><i class="fa-solid fa-trash"></i></button>
        </span>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="srd35-empty">{{localize "sheet.noWeapons"}}</p>
    {{/if}}
    <button type="button" class="srd35-add" data-action="create-item" data-item-type="weapon"><i class="fa-solid fa-plus"></i> {{localize "sheet.addWeapon"}}</button>
  </section>

  {{!-- Abilities: horizontal six-column strip --}}
  <section class="srd35-card srd35-npc-abilities-card">
    <h3 class="srd35-card-title">{{localize "sheet.attributes"}}</h3>
    <div class="srd35-npc-abilities">
      {{#each _abilities}}
      <div class="srd35-npc-ability">
        <span class="srd35-npc-ability-name">{{localize (concat "abilities." key)}}</span>
        <input class="srd35-in srd35-npc-ability-score" type="number" name="sd:abilities.{{key}}.value" value="{{value}}" />
        <button type="button" class="srd35-roll srd35-npc-ability-mod" data-action="roll-ability" data-key="{{key}}" title="{{localize "sheet.roll"}} {{localize (concat "abilities." key)}}">{{modFmt}}</button>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- Trained skills only --}}
  {{#if _skills}}
  <section class="srd35-card srd35-npc-skills">
    <h3 class="srd35-card-title">{{localize "sheet.skills"}}</h3>
    <ul class="srd35-list">
      {{#each _skills}}
      <li>
        <span class="srd35-skill-name">{{localize (concat "skills." key)}} <small>{{ability}}</small></span>
        <input class="srd35-in srd35-in-sm" type="number" step="0.5" name="sd:skills.{{key}}.ranks" value="{{ranks}}" title="{{localize "sheet.ranksShort"}}" />
        <button type="button" class="srd35-roll srd35-skill-total" data-action="roll-skill" data-key="{{key}}">{{totalFmt}}</button>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{!-- Feats --}}
  <section class="srd35-card">
    <h3 class="srd35-card-title">{{localize "sheet.feats"}}</h3>
    <ul class="srd35-list">
      {{#each _feats}}<li data-id="{{id}}">
        <button type="button" class="srd35-list-name" data-action="open-item" data-id="{{id}}">{{name}}</button>
        <button type="button" class="srd35-list-tool" data-action="delete-item" data-id="{{id}}" title="{{localize "sheet.delete"}}"><i class="fa-solid fa-trash"></i></button>
      </li>{{else}}<li class="srd35-empty">{{localize "sheet.none"}}</li>{{/each}}
    </ul>
    <button type="button" class="srd35-add" data-action="create-item" data-item-type="feat"><i class="fa-solid fa-plus"></i> {{localize "sheet.addFeat"}}</button>
  </section>

  {{!-- Notes --}}
  <section class="srd35-card srd35-notes-card">
    <textarea class="srd35-notes" name="sd:details.notes" placeholder="{{localize "sheet.notesPlaceholder"}}">{{systemData.details.notes}}</textarea>
  </section>
</div>
